{
  "name": "rebase",
  "version": "4.0.0",
  "private": true,
  "description": "Rebase pull requests in a repository",
  "main": "lib/main.js",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.4.0"
  },
  "scripts": {
    "vendor": "rm -rf src/vendor/checkout && git clone --depth=1 --branch=v7.0.1 https://github.com/actions/checkout src/vendor/checkout && rm -rf src/vendor/checkout/.git src/vendor/checkout/dist src/vendor/checkout/package-lock.json && node scripts/vendor-patch.mjs",
    "clean": "rm -rf node_modules src/vendor/checkout/node_modules pnpm-lock.yaml",
    "build-checkout": "tsc -p src/vendor/checkout",
    "prebuild": "rm -rf dist",
    "build": "tsc && esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --metafile=dist/meta.json && node scripts/licenses.mjs",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "jest unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-evans/rebase.git"
  },
  "keywords": [
    "actions",
    "pull",
    "rebase"
  ],
  "author": "Peter Evans",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/peter-evans/rebase/issues"
  },
  "homepage": "https://github.com/peter-evans/rebase",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@octokit/core": "^4.2.4",
    "@octokit/types": "^6.30.0",
    "checkout": "workspace:*",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "^4.31.2",
    "@typescript-eslint/parser": "^4.25.0",
    "esbuild": "^0.28.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-github": "^4.1.3",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jest": "^24.3.6",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^30.5.1",
    "js-yaml": "^4.1.0",
    "prettier": "^2.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
